# Core text-generation provider. At least Gemini or OpenAI must be configured.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Optional but strongly recommended cross-provider text fallback.
# Never commit a real key.
OPENAI_API_KEY="MY_OPENAI_API_KEY"
OPENAI_TEXT_MODEL="gpt-6-luna"

# Public canonical app URL used for password-reset and invitation links.
PUBLIC_APP_URL="https://autonoma.apex-engineering.co.in"
APP_BASE_URL="https://autonoma.apex-engineering.co.in"

# Supabase production persistence (server-side service role only).
SUPABASE_URL="MY_SUPABASE_URL"
SUPABASE_SERVICE_ROLE_KEY="MY_SUPABASE_SERVICE_ROLE_KEY"

# Transactional email for invites and password resets.
RESEND_API_KEY="MY_RESEND_API_KEY"
SMTP_FROM="Autonoma <onboarding@apex-engineering.co.in>"

# Optional Google Sheets secondary synchronization endpoint.
AUTONOMA_SHEETS_WEBAPP_URL="https://script.google.com/macros/s/AKfycbyyTzei9wvOAWbDrFeaGhk2fFkwsWVgBqK-zcFdAQH_dMKVKAQE2wLSIjvdqZHGct5m/exec"

# Canonical Super Administrator identity.
INITIAL_SUPER_ADMIN_EMAIL="amarpawar2007@gmail.com"

# Optional media providers.
CLOUDFLARE_ACCOUNT_ID="MY_CLOUDFLARE_ACCOUNT_ID"
CLOUDFLARE_API_TOKEN="MY_CLOUDFLARE_API_TOKEN"
NVIDIA_API_KEY="MY_NVIDIA_API_KEY"
